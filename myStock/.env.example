# Copiar este archivo como .env.local y poner los valores de tu proyecto.
# Están en Supabase: botón "Connect" (arriba) o Settings > API Keys.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Usa UNA de las dos (la que te muestre tu proyecto):
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
